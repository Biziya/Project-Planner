  "HoleId": {
    "Pattern": "^(?<letter>[PIUM])(?<project>[A-Z]{2})_(?<east>\\d{3})_(?<north>\\d{3})_(?<bin>\\d{2}_[A-Z])(?<bis>_|[2-5])$",
