    "RefusedLetters": [ "C", "B" ]
  },

  "Validation": {
    "MandatoryFields": [ "HoleId", "ProjectCode", "Prospect", "TechnoWellKey", "X", "Y", "Z", "CoordinateSet", "HolePurpose", "SubPurpose", "PlanDrillType", "HolePlanDepth" ],
    "ZMin": null,
    "ZMax": null,
    "MinDistance": null,
    "SameCoordinatesLevel": "Warning",
    "KeyMustBeUnique": true,
    "KeyMustBeNumeric": true,
    "SubPurposeLetters": { "PRODUCER": "P", "INJECTOR": "I", "UNIVERSAL": "U", "MONITORING": "M" },
    "MaxCommentLength": 4000,
    "GtnSameIntervals": true
  }
