{
  // Copy to appsettings.Development.json (git-ignored, used by "dotnet run") and adjust.
  "Auth": {
    "Mode": "Dev",
    "DevUser": "dev.user",
    "DevIsSupervisor": true
  },

  // Leave empty to run without a database: /api/health then reports "notConfigured".
  "ConnectionStrings": {
    "TechnoWells": "Server=YOUR_SQL_SERVER;Database=YOUR_DATABASE;Integrated Security=true;TrustServerCertificate=true"
  }
}
