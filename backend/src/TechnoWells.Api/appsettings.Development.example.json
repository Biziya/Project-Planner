{
  // Copy to appsettings.Development.json (used by "dotnet run") and adjust.
  // Sql mode against the development database; writes go to ACQMN01_DEV through acquire-queries.sql.
  "Storage": { "Mode": "Sql" },
  "Auth": { "Mode": "Dev", "DevUser": "your.name", "DevIsSupervisor": true },

  "ConnectionStrings": {
    "Staging": "Server=BMNULAADB02;Database=ACQMN01_DEV;Integrated Security=true;TrustServerCertificate=true",
    "Acquire": "Server=BMNULAADB02;Database=ACQMN01_DEV;Integrated Security=true;TrustServerCertificate=true"
  },

  "AcquireSql": { "QueriesFile": "acquire-queries.sql" },

  // Test HOLEIDs: also accept the letter T (e.g. TZO_900_001_44_A_)
  "HoleId": {
    "Pattern": "^(?<letter>[PIUMT])(?<project>[A-Z]{2})_(?<east>\\d{3})_(?<north>\\d{3})_(?<bin>\\d{2}_[A-Z])(?<bis>_|[2-5])$"
  },

  "Validation": {
    "MinDistance": 10,
    "SameCoordinatesLevel": "Warning"
  }
}
