{
  // Copy into appsettings.Production.json (or user secrets) and fill with the acQuire administrator.
  // Comments are allowed in ASP.NET Core JSON settings files.
  "Storage": { "Mode": "Sql" },
  "Auth": { "Mode": "Windows", "SupervisorGroup": "YOUR_DOMAIN\\TechnoWells_Supervisors" },

  "ConnectionStrings": {
    "Staging": "Server=YOUR_SQL_SERVER;Database=ACQMN01_DEV;Integrated Security=true;TrustServerCertificate=true",
    "Acquire": "Server=YOUR_SQL_SERVER;Database=ACQMN01_DEV;Integrated Security=true;TrustServerCertificate=true"
  },

  "AcquireSql": {
    "LookupCacheMinutes": 5,
    // Recommended: write the queries in acquire-queries.sql (commented, testable in SSMS).
    // Queries found in that file replace the values below.
    "QueriesFile": "acquire-queries.sql",

    // ---- Reads (TO ADAPT to the acQuire schema) ----------------------------
    // Columns: HoleId, Status, ProjectCode, Prospect, HolePurpose, HolePlanTarget, X, Y, Z
    // Filters: @Search, @Status, @Project, @Prospect, @Purpose, @Target (NULL = no filter)
    "ListProgramHoles": "",
    // Columns: TableName, Name, Value  — attributes of HOLEDETAILS, HOLECOMMENT, HOLEBIGCOMMENT for @HoleId
    "HoleAttributes": "",
    // Columns: GeolFrom, GeolTo, Name, Value, Priority — planned GTN (LithoPlanned, CACO3_Risks) for @HoleId
    "HoleGtn": "",
    // One text value that changes whenever the hole changes (row version or last-modified) for @HoleId
    "HoleVersion": "",
    // Highest numeric KEY among ALL holes, any status (suggested KEY = this + 1), e.g. MAX(TRY_CAST(VALUE AS BIGINT))
    "MaxKey": "",
    // Returns 1 when another hole than @HoleId uses @Key (TechnoWellKey)
    "KeyExists": "",

    // ---- Writes: the load path agreed with the acQuire administrator --------
    // Run in one transaction after a lock on the HOLEID. Empty = sending is refused.
    "InsertLocation": "",      // @HoleId, @ProjectCode, @Prospect, @TenementId
    "UpdateLocation": "",      // same parameters
    "UpsertCoord": "",         // @HoleId, @CoordinateSet, @X, @Y, @Z
    "UpsertAttribute": "",     // @HoleId, @TableName, @Name, @Value (NULL clears the value)
    "DeletePlannedGtn": "",    // @HoleId
    "InsertGtn": ""            // @HoleId, @GeolFrom, @GeolTo, @Name, @Value, @Priority
  },

  // Excel layout: provisional until the users' template arrives. Replace the lists to match it.
  "ExcelTemplate": {
    "Version": "0.1",
    "HolesSheet": "Holes",
    "IntervalsSheet": "Intervals",
    "GtnSheet": "GTN"
    // "HoleColumns": [ { "Header": "HOLEID", "Field": "HoleId" }, { "Header": "Project", "Field": "ProjectCode", "Lookup": "L01" }, ... ]
  }
}
